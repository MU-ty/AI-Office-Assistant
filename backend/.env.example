# FastAPI 后端认证服务配置
# 在项目根目录创建 .env 文件并复制此配置

# 应用配置
PROJECT_NAME=AI Office Assistant
VERSION=1.0.0
DEBUG=False

# 数据库配置（与 docker-compose.yml 保持一致）
DATABASE_USER=office_user
DATABASE_PASSWORD=office_password
DATABASE_HOST=office_assistant_postgres
DATABASE_PORT=5432
DATABASE_NAME=office_assistant

# Redis 配置（与 docker-compose.yml 保持一致）
REDIS_HOST=office_assistant_redis
REDIS_PORT=6379
REDIS_DB=0

# JWT 配置
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-9e7f8a8b9c0d1e2f3g4h5i6j7k8l9m0n
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码配置
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL_CHARS=False

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# SMTP 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
